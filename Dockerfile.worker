# CourseDeveloper.Worker image (STEP 6) — bundles the .NET worker AND the Python runtime +
# academy-brain code from this exact repo commit into one image (DEC-004: no separate
# academy-brain release to pin), replacing the machine-specific dev venv path
# AcademyBrainSubprocessExecutor previously depended on.
#
# Build from the REPO ROOT (needs both backend/ and academy-brain/ in its context):
#   docker build -f Dockerfile.worker -t course-developer-worker .

# Stage 1: .NET build
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS dotnet-build
WORKDIR /source
COPY backend/CourseDeveloper.sln .
COPY backend/src/CourseDeveloper.Core/CourseDeveloper.Core.csproj src/CourseDeveloper.Core/
COPY backend/src/CourseDeveloper.Infrastructure/CourseDeveloper.Infrastructure.csproj src/CourseDeveloper.Infrastructure/
COPY backend/src/CourseDeveloper.Api/CourseDeveloper.Api.csproj src/CourseDeveloper.Api/
COPY backend/src/CourseDeveloper.Worker/CourseDeveloper.Worker.csproj src/CourseDeveloper.Worker/
COPY backend/tests/CourseDeveloper.UnitTests/CourseDeveloper.UnitTests.csproj tests/CourseDeveloper.UnitTests/
RUN dotnet restore src/CourseDeveloper.Worker/CourseDeveloper.Worker.csproj
COPY backend/src/ src/
WORKDIR /source/src/CourseDeveloper.Worker
RUN dotnet publish -c Release -o /app/publish --no-restore

# Stage 2: final runtime — .NET worker + a Python venv holding academy-brain's dependencies,
# built via uv from this exact commit's academy-brain/pyproject.toml + uv.lock (the same
# lockfile local dev already uses — no separate dependency resolution to keep in sync).
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

WORKDIR /academy-brain
COPY academy-brain/pyproject.toml academy-brain/uv.lock ./
RUN uv sync --frozen --no-dev --python python3
COPY academy-brain/ .

WORKDIR /app
COPY --from=dotnet-build /app/publish .

# STEP 11 Phase B, Batch 2/3: every side-channel script CourseDeveloper.Infrastructure's
# subprocess adapters shell out to (PythonPdfTextExtractor, PythonPdfColorExtractor,
# PythonPedagogyCoverageEvaluator, PythonNblmPromptPreflightEvaluator, PythonNblmPromptRenderer)
# needs its own explicit path here — each adapter fails closed (throws at construction) if its
# env var is unset, so an omission here would only surface once an organization enables the
# corresponding gate, not at build/start time (found by Codex review: Batch 2's two PDF paths
# were already missing before Batch 3 added three more of the same pattern).
ENV ACADEMY_BRAIN_SCRIPT_PATH=/academy-brain/scripts/swarm/generate_session.py \
    ACADEMY_BRAIN_PDF_TEXT_SCRIPT_PATH=/academy-brain/scripts/swarm/extract_pdf_text.py \
    ACADEMY_BRAIN_PDF_COLOR_SCRIPT_PATH=/academy-brain/scripts/swarm/extract_pdf_colors.py \
    ACADEMY_BRAIN_PEDAGOGY_SCRIPT_PATH=/academy-brain/scripts/swarm/evaluate_pedagogy_coverage.py \
    ACADEMY_BRAIN_NBLM_PREFLIGHT_SCRIPT_PATH=/academy-brain/scripts/swarm/evaluate_nblm_prompt_preflight.py \
    ACADEMY_BRAIN_NBLM_RENDER_SCRIPT_PATH=/academy-brain/scripts/swarm/nblm_prompt_template.py \
    GENERATION_WORKER_PYTHON_EXECUTABLE=/academy-brain/.venv/bin/python

ARG STUDIO_COMMIT_SHA=unknown
ENV STUDIO_COMMIT_SHA=${STUDIO_COMMIT_SHA}

ENTRYPOINT ["dotnet", "CourseDeveloper.Worker.dll"]
