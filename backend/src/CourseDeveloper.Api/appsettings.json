{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Override via SUPABASE_CONNECTION_STRING env var for production (see backend/.env.example).
    "SupabaseDb": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=PLACEHOLDER-SET-SUPABASE_CONNECTION_STRING;"
  },
  "Supabase": {
    // Override via SUPABASE_URL env var for production (see backend/.env.example).
    // AnonKey and ServiceRoleKey are intentionally absent — no backend code reads them
    // from appsettings.json. SUPABASE_SERVICE_ROLE_KEY is read from env by the Worker.
    "ProjectUrl": "https://YOUR-PROJECT-REF.supabase.co"
  },
  "Obsidian": {
    "VaultPath": "obsidian-vault-template"
  }
}
