# CourseDeveloper backend — required environment variables
# Copy this file to .env (or set these in your deployment environment).
# This file contains VARIABLE NAMES ONLY. Never add real values here.
# .env is in .gitignore; this .env.example is safe to commit.

# ------------------------------------------------------------------------------
# CourseDeveloper.Api
# ------------------------------------------------------------------------------

# Full Npgsql connection string authenticating as the narrowly-scoped studio_api
# Postgres role. Overrides ConnectionStrings:SupabaseDb in appsettings.json.
# Required for any database operation.
SUPABASE_CONNECTION_STRING=

# Supabase project base URL (for example, https://YOUR-PROJECT-REF.supabase.co).
# Used to construct the JWT issuer endpoint for incoming request validation.
# Overrides Supabase:ProjectUrl in appsettings.json.
# Required for valid authentication outside placeholder-only local configuration.
SUPABASE_URL=

# Comma-separated list of frontend origins allowed by CORS policy.
# Example: https://YOUR-APP.example.invalid,https://YOUR-STAGING-APP.example.invalid
# Falls back to appsettings.json Cors:AllowedOrigins, then http://localhost:3000.
# CORS_ALLOWED_ORIGINS=

# Optional: defaults to enabled. Set to "false" to disable Swagger UI outside
# Development; Development always enables it.
# ENABLE_SWAGGER=

# Optional: set to "true" to enable HTTPS redirection middleware.
# ENABLE_HTTPS_REDIRECTION=

# ------------------------------------------------------------------------------
# CourseDeveloper.Worker
# ------------------------------------------------------------------------------

# Full Npgsql connection string authenticating as the generation_worker Postgres
# role. REQUIRED — the worker refuses to start without it and will not accept any
# other role name.
GENERATION_WORKER_CONNECTION_STRING=

# Supabase project base URL. Required for the Worker to upload generated course
# artifacts to Supabase Storage. If unset, uploads are silently skipped and
# artifacts remain on local disk only.
# SUPABASE_PROJECT_URL=

# Supabase service-role JWT. Required for authenticated writes to Supabase
# Storage. If either this or SUPABASE_PROJECT_URL is unset, uploads are skipped.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: override the Supabase Storage bucket for generated artifacts.
# Defaults to "course-artifacts".
# GENERATION_ARTIFACT_BUCKET=

# Absolute path to the academy-brain entry-point script. REQUIRED by the active
# worker executor; there is no fallback.
ACADEMY_BRAIN_SCRIPT_PATH=

# Python executable to use when shelling out to academy-brain scripts.
# Defaults to "python".
# GENERATION_WORKER_PYTHON_EXECUTABLE=

# Paths to academy-brain side-channel scripts. All five are REQUIRED by the
# current Worker dependency graph and have no fallback.
ACADEMY_BRAIN_PEDAGOGY_SCRIPT_PATH=
ACADEMY_BRAIN_PDF_TEXT_SCRIPT_PATH=
ACADEMY_BRAIN_PDF_COLOR_SCRIPT_PATH=
ACADEMY_BRAIN_NBLM_RENDER_SCRIPT_PATH=
ACADEMY_BRAIN_NBLM_PREFLIGHT_SCRIPT_PATH=

# Optional: polling interval in seconds. Defaults to 2.
# GENERATION_WORKER_POLL_INTERVAL_SECONDS=

# Optional: claimed-job lease duration in seconds. Defaults to 30; heartbeat
# cadence is derived from this value with a minimum of 5 seconds.
# GENERATION_WORKER_LEASE_SECONDS=

# Optional: simulated duration in seconds for StubGenerationJobExecutor.
# Defaults to 20 and has no effect while the real executor remains registered.
# GENERATION_WORKER_STUB_DURATION_SECONDS=

# ------------------------------------------------------------------------------
# Infrastructure / shared
# ------------------------------------------------------------------------------

# Root directory of the Obsidian vault used by ObsidianVaultService.
# Falls back to the relative path configured in appsettings.json Obsidian:VaultPath.
# VAULT_ROOT=

# Git commit SHA injected into worker log output for traceability.
# STUDIO_COMMIT_SHA=
